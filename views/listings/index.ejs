<% layout("/layouts/boilerplate") %>

  <!-- Main Search & Filter Container -->
  <div class="container-fluid px-4 mt-3">

    <!-- Main Search Bar (Visible primarily on Home) -->
    <div class="search-container-main">
      <form action="/listings" method="GET" class="search-bar-main">
        <label for="main-search" class="ms-3 me-2"><i class="fa-solid fa-magnifying-glass text-secondary"></i></label>
        <input type="text" id="main-search" name="search" placeholder="Search destinations, villas, castles..."
          value="<%= typeof search !== 'undefined' ? search : '' %>">
        <button type="submit" class="search-btn-main"><i class="fa-solid fa-arrow-right"></i></button>
      </form>
    </div>

    <!-- Category Filters -->
    <div id="filters" class="filters-wrapper d-flex align-items-center justify-content-center">
      <button class="scroll-btn left-btn d-none d-md-flex me-2" onclick="scrollFilters(-1)"><i
          class="fa-solid fa-angle-left"></i></button>

      <div class="filters-scroll" id="filtersScroll">
        <a href="/listings?category=Trending" class="filter"><i class="fa-solid fa-fire"></i>
          <p>Trending</p>
        </a>
        <a href="/listings?category=Rooms" class="filter"><i class="fa-solid fa-bed"></i>
          <p>Rooms</p>
        </a>
        <a href="/listings?category=Beach" class="filter"><i class="fa-solid fa-umbrella-beach"></i>
          <p>Beach</p>
        </a>
        <a href="/listings?category=Mountains" class="filter"><i class="fa-solid fa-mountain-sun"></i>
          <p>Mountains</p>
        </a>
        <a href="/listings?category=Cabins" class="filter"><i class="fa-solid fa-tree"></i>
          <p>Cabins</p>
        </a>
        <a href="/listings?category=City" class="filter"><i class="fa-solid fa-city"></i>
          <p>City</p>
        </a>
        <a href="/listings?category=Camping" class="filter"><i class="fa-solid fa-campground"></i>
          <p>Camping</p>
        </a>
        <a href="/listings?category=Pools" class="filter"><i class="fa-solid fa-person-swimming"></i>
          <p>Pools</p>
        </a>
        <a href="/listings?category=Pet Friendly" class="filter"><i class="fa-solid fa-dog"></i>
          <p>Pets</p>
        </a>
        <a href="/listings?category=Villas" class="filter"><i class="fa-solid fa-house-chimney"></i>
          <p>Villas</p>
        </a>
        <a href="/listings?category=Castles" class="filter"><i class="fa-solid fa-chess-rook"></i>
          <p>Castles</p>
        </a>
        <a href="/listings?category=Tiny Homes" class="filter"><i class="fa-solid fa-van-shuttle"></i>
          <p>Tiny Homes</p>
        </a>
        <a href="/listings?category=Unique Stays" class="filter"><i class="fa-solid fa-ufo"></i>
          <p>Unique</p>
        </a>
      </div>

      <button class="scroll-btn right-btn d-none d-md-flex ms-2" onclick="scrollFilters(1)"><i
          class="fa-solid fa-angle-right"></i></button>
    </div>
  </div>

  <!-- Tax Toggle (Optional: Positioned Top Right or Bottom Fixed. Let's keep simpler for now or hide if clutter) -->
  <!-- Simplified: Display toggle in a clean row if needed. For visual balance, maybe omit or place neatly. -->
  <!-- Placing it inline or below filters is common. -->


  <div class="container mt-2">
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
      <% if (allListings && allListings.length> 0) { %>
        <% for (let listing of allListings) { %>
          <div class="col">
            <div class="listing-card">
              <a href="/listings/<%= listing._id %>">
                <img src="<%= listing.image.url || '/images/default.jpg' %>" class="card-img-top"
                  alt="<%= listing.title %>" />
                <div class="card-body">
                  <div class="title-line">
                    <%= listing.title %>
                  </div>
                  <div class="text-secondary" style="font-size: 0.9rem;">
                    <%= listing.location %>, <%= listing.country %>
                  </div>
                  <div class="price-line">
                    <b>₹<%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %></b> <span
                      class="fw-normal text-secondary">night</span>
                  </div>
                </div>
              </a>
            </div>
          </div>
          <% } %>
            <% } else { %>
              <div class="col-12">
                <div class="empty-state d-flex flex-column align-items-center justify-content-center">
                  <i class="fa-regular fa-face-frown-open empty-icon"></i>
                  <h3>No matches found</h3>
                  <p class="text-secondary">Try changing your search or category filter.</p>
                  <a href="/listings" class="btn btn-outline-dark mt-3 rounded-pill px-4">Clear Filters</a>
                </div>
              </div>
              <% } %>
    </div>
  </div>

  <script>
    function scrollFilters(direction) {
      const container = document.getElementById('filtersScroll');
      const scrollAmount = 300;
      container.scrollBy({ left: direction * scrollAmount, behavior: 'smooth' });
    }
  </script>