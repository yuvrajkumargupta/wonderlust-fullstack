<% layout("/layouts/boilerplate") %>

  <!-- Main Container -->
  <div class="container-fluid px-4 mt-3">

    <!-- Filters & Tax Toggle Ribbon -->
    <!-- "Ribbon" Bar: Categories on left/center, Tax Toggle on right -->
    <div class="filters-main-container d-flex align-items-center justify-content-between mb-4">

      <!-- Scrollable Categories -->
      <div id="filters" class="filters-wrapper d-flex align-items-center">
        <button class="scroll-btn left-btn d-none d-md-flex me-2 shadow-sm" onclick="scrollFilters(-1)"><i
            class="fa-solid fa-angle-left"></i></button>

        <div class="filters-scroll" id="filtersScroll">
          <!-- All Categories -->
          <% 
            const cats = [
              { id: "Trending", icon: "fa-fire" },
              { id: "Rooms", icon: "fa-bed" },
              { id: "Beach", icon: "fa-umbrella-beach" },
              { id: "Mountains", icon: "fa-mountain-sun" },
              { id: "Castles", icon: "fa-chess-rook" },
              { id: "Pools", icon: "fa-person-swimming" },
              { id: "Camping", icon: "fa-campground" },
              { id: "Farms", icon: "fa-cow" },
              { id: "Arctic", icon: "fa-snowflake" },
              { id: "Domes", icon: "fa-igloo" },
              { id: "Boats", icon: "fa-ship" }
            ];
          %>
          <% for( let c of cats ) { %>
            <a href="/listings?category=<%= c.id %><%= search ? '&search=' + search : '' %><%= sort ? '&sort=' + sort : '' %>" class="filter <%= category === c.id ? 'active' : '' %>">
              <i class="fa-solid <%= c.icon %>"></i>
              <p><%= c.id %></p>
            </a>
          <% } %>
        </div>

        <button class="scroll-btn right-btn d-none d-md-flex ms-2 shadow-sm" onclick="scrollFilters(1)"><i
            class="fa-solid fa-angle-right"></i></button>
      </div>

      <div class="d-flex align-items-center ms-auto">
        <!-- Sort Dropdown -->
        <div class="dropdown me-3 d-none d-md-flex">
          <button class="btn btn-outline-secondary dropdown-toggle rounded-pill" type="button" id="sortDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 0.9rem; font-weight: 500;">
            <i class="fa-solid fa-sort"></i> Sort 
          </button>
          <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" aria-labelledby="sortDropdown">
            <li><a class="dropdown-item <%= sort === 'priceAsc' ? 'active bg-danger border-danger' : '' %>" href="/listings?page=1<%= search ? '&search=' + search : '' %><%= category ? '&category=' + category : '' %>&sort=priceAsc">Price: Low to High</a></li>
            <li><a class="dropdown-item <%= sort === 'priceDesc' ? 'active bg-danger border-danger' : '' %>" href="/listings?page=1<%= search ? '&search=' + search : '' %><%= category ? '&category=' + category : '' %>&sort=priceDesc">Price: High to Low</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item <%= !sort ? 'active bg-danger border-danger' : '' %>" href="/listings?page=1<%= search ? '&search=' + search : '' %><%= category ? '&category=' + category : '' %>">Newest First</a></li>
          </ul>
        </div>


      </div>

    </div>
  </div>

  <!-- Listings Grid -->
  <div class="container-fluid px-4">
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 card-container">
      <% if (allListings && allListings.length > 0) { %>
        <% for (let listing of allListings) { %>
          <div class="col">
            <div class="listing-card">
              <a href="/listings/<%= listing._id %>" class="stretched-link"></a>
              <i class="fa-solid fa-heart wishlist-heart"></i>
              <div class="img-wrapper shadow-sm">
                <img src="<%= (listing.image && listing.image.url) ? listing.image.url : '/images/default.jpg' %>"
                  class="card-img-top" alt="<%= listing.title %>" />
              </div>
              <div class="card-body">
                <div class="title-line fw-bold text-dark fs-6">
                  <%= listing.location %>, <%= listing.country %>
                </div>
                <div class="text-secondary mb-1" style="font-size: 0.95rem;">
                  <%= listing.title %>
                </div>
                <div class="price-line text-dark mt-1">
                  <span class="fw-bold fs-6">₹<%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %></span> <span class="fw-normal text-secondary">night</span>
                </div>
              </div>
            </div>
          </div>
        <% } %>
            <% } else { %>
              <div class="col-12 w-100">
                <div class="empty-state d-flex flex-column align-items-center justify-content-center p-5 shadow-sm border-0 bg-white" style="border-radius: 24px;">
                  <i class="fa-solid fa-map-location-dot text-secondary mb-3" style="font-size: 3rem; opacity: 0.6;"></i>
                  <h3 class="fw-bold mb-2">No exact matches</h3>
                  <p class="text-secondary fs-5 mb-4">Try changing or removing some of your filters or adjusting your search area.</p>
                  <a href="/listings" class="btn btn-outline-dark btn-lg rounded-pill px-5 fw-bold hover-btn">Clear all filters</a>
                </div>
              </div>
            <% } %>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
      <div class="d-flex justify-content-center mt-5 mb-4">
        <nav aria-label="Page navigation">
          <ul class="pagination pagination-md">
            <!-- Previous Button -->
            <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
              <a class="page-link text-danger" href="/listings?page=<%= currentPage - 1 %><%= search ? '&search=' + search : '' %><%= category ? '&category=' + category : '' %><%= sort ? '&sort=' + sort : '' %>" aria-label="Previous">
                <span aria-hidden="true">&laquo;</span>
              </a>
            </li>
            
            <!-- Page Numbers -->
            <% 
              // Simple pagination logic to show limited pages
              let startPage = Math.max(1, currentPage - 2);
              let endPage = Math.min(totalPages, currentPage + 2);
            %>
            
            <% for( let i = startPage; i <= endPage; i++ ) { %>
              <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                <a class="page-link <%= currentPage === i ? 'bg-danger border-danger text-white' : 'text-danger' %>" href="/listings?page=<%= i %><%= search ? '&search=' + search : '' %><%= category ? '&category=' + category : '' %><%= sort ? '&sort=' + sort : '' %>"><%= i %></a>
              </li>
            <% } %>

            <!-- Next Button -->
            <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
              <a class="page-link text-danger" href="/listings?page=<%= currentPage + 1 %><%= search ? '&search=' + search : '' %><%= category ? '&category=' + category : '' %><%= sort ? '&sort=' + sort : '' %>" aria-label="Next">
                <span aria-hidden="true">&raquo;</span>
              </a>
            </li>
          </ul>
        </nav>
      </div>
    <% } %>

  </div>

  <script>
    function scrollFilters(direction) {
      const container = document.getElementById('filtersScroll');
      const scrollAmount = 300;
      container.scrollBy({ left: direction * scrollAmount, behavior: 'smooth' });
    }
  </script>