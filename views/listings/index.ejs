<% layout("/layouts/boilerplate") %>

  <!-- Main Container -->
  <div class="container-fluid px-4 mt-3">

    <!-- Filters & Tax Toggle Ribbon -->
    <!-- "Ribbon" Bar: Categories on left/center, Tax Toggle on right -->
    <div class="filters-main-container d-flex align-items-center justify-content-between mb-4">

      <!-- Scrollable Categories -->
      <div id="filters" class="filters-wrapper d-flex align-items-center">
        <button class="scroll-btn left-btn d-none d-md-flex me-2 shadow-sm" onclick="scrollFilters(-1)"><i
            class="fa-solid fa-angle-left"></i></button>

        <div class="filters-scroll" id="filtersScroll">
          <!-- All Categories -->
          <a href="/listings?category=Trending" class="filter"><i class="fa-solid fa-fire"></i>
            <p>Trending</p>
          </a>
          <a href="/listings?category=Rooms" class="filter"><i class="fa-solid fa-bed"></i>
            <p>Rooms</p>
          </a>
          <a href="/listings?category=Beach" class="filter"><i class="fa-solid fa-umbrella-beach"></i>
            <p>Beach</p>
          </a>
          <a href="/listings?category=Mountains" class="filter"><i class="fa-solid fa-mountain-sun"></i>
            <p>Mountains</p>
          </a>
          <a href="/listings?category=Castles" class="filter"><i class="fa-solid fa-chess-rook"></i>
            <p>Castles</p>
          </a>
          <a href="/listings?category=Pools" class="filter"><i class="fa-solid fa-person-swimming"></i>
            <p>Pools</p>
          </a>
          <a href="/listings?category=Camping" class="filter"><i class="fa-solid fa-campground"></i>
            <p>Camping</p>
          </a>
          <a href="/listings?category=Farms" class="filter"><i class="fa-solid fa-cow"></i>
            <p>Farms</p>
          </a>
          <a href="/listings?category=Arctic" class="filter"><i class="fa-solid fa-snowflake"></i>
            <p>Arctic</p>
          </a>
          <a href="/listings?category=Domes" class="filter"><i class="fa-solid fa-igloo"></i>
            <p>Domes</p>
          </a>
          <a href="/listings?category=Boats" class="filter"><i class="fa-solid fa-ship"></i>
            <p>Boats</p>
          </a>
        </div>

        <button class="scroll-btn right-btn d-none d-md-flex ms-2 shadow-sm" onclick="scrollFilters(1)"><i
            class="fa-solid fa-angle-right"></i></button>
      </div>

      <!-- Tax Toggle (Right Side) -->
      <div
        class="tax-toggle-box ms-3 d-none d-md-flex align-items-center border rounded-pill px-3 py-2 shadow-sm bg-white">
        <div class="form-check form-switch form-check-reverse mb-0">
          <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
          <label class="form-check-label text-nowrap" for="flexSwitchCheckDefault"
            style="font-size: 0.9rem; font-weight: 500;">Display total before taxes</label>
        </div>
      </div>

    </div>
  </div>

  <!-- Listings Grid -->
  <div class="container-fluid px-4">
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 card-container">
      <% if (allListings && allListings.length> 0) { %>
        <% for (let listing of allListings) { %>
          <div class="col">
            <div class="listing-card">
              <a href="/listings/<%= listing._id %>">
                <img src="<%= (listing.image && listing.image.url) ? listing.image.url : '/images/default.jpg' %>"
                  class="card-img-top" alt="<%= listing.title %>" />
                <div class="card-body">
                  <div class="title-line">
                    <%= listing.title %>
                  </div>
                  <div class="text-secondary" style="font-size: 0.9rem;">
                    <%= listing.location %>, <%= listing.country %>
                  </div>
                  <div class="price-line">
                    <b>₹<%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %></b> <span
                      class="fw-normal text-secondary">night</span>
                  </div>
                </div>
              </a>
            </div>
          </div>
          <% } %>
            <% } else { %>
              <div class="col-12">
                <div class="empty-state d-flex flex-column align-items-center justify-content-center">
                  <i class="fa-regular fa-face-frown-open empty-icon"></i>
                  <h3>No matches found</h3>
                  <p class="text-secondary">Try changing your search or category filter.</p>
                  <a href="/listings" class="btn btn-outline-dark mt-3 rounded-pill px-4">Clear Filters</a>
                </div>
              </div>
              <% } %>
    </div>
  </div>

  <script>
    function scrollFilters(direction) {
      const container = document.getElementById('filtersScroll');
      const scrollAmount = 300;
      container.scrollBy({ left: direction * scrollAmount, behavior: 'smooth' });
    }
  </script>