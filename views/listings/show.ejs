<% layout("/layouts/boilerplate") %>
  <script>
    const mapToken = "<%= process.env.MAP_TOKEN || process.env.MAP_TOCKEN %>";
    const listing = <%- JSON.stringify(listing) %>;
  </script>

  <div class="container listing-details">

    <!-- Listing Title -->
    <h2 class="page-title text-center">
      <%= listing.title %>
    </h2>

    <!-- Listing Layout Structure -->
    <div class="row">
      <!-- Left Column: Listing Details -->
      <div class="col-md-8 col-12 pe-md-4">
        <div class="card shadow-sm mb-5 border-0" style="border-radius: 12px; overflow: hidden;">
          <img src="<%= listing.image.url %>" class="card-img-top" alt="Listing image" style="height: 450px; object-fit: cover;">
          <div class="card-body p-4">
            <h5 class="fw-bold mb-3">Entire place hosted by <%= listing.owner ? listing.owner.username : 'Unknown Owner' %></h5>
            <p class="card-text text-muted mb-4" style="line-height: 1.8; font-size: 1.05rem;">
              <%= listing.description %>
            </p>
            <hr class="my-4">
            <p class="card-text mb-2"><strong class="fs-5">Location</strong></p>
            <p class="text-muted"><i class="fa-solid fa-location-dot me-2 text-danger"></i> <%= listing.location %>, <%= listing.country %></p>
          </div>
        </div>
      </div>

      <!-- Right Column: Booking Widget -->
      <div class="col-md-4 col-12 mb-5">
        <div class="card shadow-sm border-0 sticky-top" style="top: 100px; border-radius: 12px;">
          <div class="card-body p-4">
            <h4 class="card-title mb-4">Book your stay</h4>
            <p class="text-muted"><span class="fs-5 fw-bold text-dark">₹<%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %></span> night</p>
            <hr>
            <form action="/listings/<%= listing._id %>/bookings" method="POST" class="needs-validation" novalidate>
              <div class="row g-2 mb-3">
                <div class="col-6">
                  <label for="checkIn" class="form-label small fw-bold">CHECK-IN</label>
                  <input type="date" class="form-control" id="checkIn" name="checkIn" required>
                </div>
                <div class="col-6">
                  <label for="checkOut" class="form-label small fw-bold">CHECKOUT</label>
                  <input type="date" class="form-control" id="checkOut" name="checkOut" required>
                </div>
              </div>
              
              <% if(!currUser) { %>
                <a href="/login" class="btn btn-danger w-100 py-3 rounded-3 fw-bold mt-3">Log in to Reserve</a>
              <% } else if (currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
                <button type="button" class="btn btn-secondary w-100 py-3 rounded-3 fw-bold mt-3" disabled>You own this property</button>
              <% } else { %>
                <button type="submit" class="btn btn-danger w-100 py-3 rounded-3 fw-bold mt-3 hover-btn">Reserve Now</button>
              <% } %>
            </form>
            <p class="text-center text-muted small mt-3 mb-0">You won't be charged yet</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="action-buttons text-center mb-5">
      <% if(currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-warning me-2">Edit</a>
        <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" class="d-inline">
          <button type="submit" class="btn btn-danger">Delete</button>
        </form>
        <% } %>
          <a href="/listings" class="btn btn-secondary ms-2">⬅ Back to Listings</a>
    </div>

    <!-- Review Form -->
    <% if(currUser){ %>
      <div class="review-form shadow-sm p-4 mx-auto mb-5">
        <h4 class="mb-3 text-center">Leave a Review</h4>
        <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
          <div class="mb-3">
            <label for="rating" class="form-label">Rating</label>
            <fieldset class="starability-slot">
              <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked
                aria-label="No rating." />
              <% for(let i=1; i<=5; i++){ %>
                <input type="radio" id="rate<%= i %>" name="review[rating]" value="<%= i %>" />
                <label for="rate<%= i %>" title="<%= [" Terrible","Not good","Average","Very good","Amazing"][i-1] %>">
                  <%= i %> star
                </label>
                <% } %>
            </fieldset>
          </div>

          <div class="mb-3">
            <label for="comment" class="form-label">Your Comments</label>
            <textarea class="form-control" name="review[comment]" id="comment" rows="4"
              placeholder="Write your thoughts here..." required></textarea>
            <div class="invalid-feedback">Please add some valid comments!</div>
          </div>

          <div class="text-center">
            <button type="submit" class="btn btn-primary">Submit Review</button>
          </div>
        </form>
      </div>
      <% } %>

        <!-- All Reviews -->
        <% if(listing.reviews && listing.reviews.length> 0){ %>
          <div class="all-reviews mb-5">
            <h4 class="mb-4 text-center">All Reviews</h4>
            <div class="row g-4 justify-content-center">
              <% for(let review of listing.reviews) { %>
                <div class="col-12 col-md-6 col-lg-4">
                  <div class="card review-card h-100">
                    <div class="card-body">
                      <h5 class="card-title">@<%= review.author ? review.author.username : 'Anonymous' %>
                      </h5>
                      <p class="starability-result mb-2" data-rating="<%= review.rating %>"></p>
                      <p class="card-text">
                        <%= review.comment %>
                      </p>
                      <% if(currUser && review.author && review.author._id.equals(currUser._id)) { %>
                        <form method="POST"
                          action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                          <button type="submit" class="btn btn-sm btn-dark">Delete</button>
                        </form>
                        <% } %>
                    </div>
                  </div>
                </div>
                <% } %>
            </div>
          </div>
          <% } %>

            <!-- Map -->
            <% if(listing.geometry && listing.geometry.coordinates && listing.geometry.coordinates.length> 0) { %>
              <div class="map-container mb-5 mx-auto">
                <h3 class="text-center mb-3">Where you'll be</h3>
                <div id="map"></div>
              </div>
              <% } %>
  </div>
  </div>

  <script src="/js/map.js"></script>